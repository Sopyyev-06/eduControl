# ---- runtime -------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8080
TRUST_PROXY=true

# ---- database ------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=educontrol
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=educontrol
DB_POOL_MAX=10

# ---- secrets (generate: openssl rand -hex 32 / openssl rand -base64 48) --
JWT_SECRET=CHANGE_ME_at_least_32_random_chars
PII_KEY=CHANGE_ME_64_HEX_CHARS_32_BYTES
PII_KEY_VERSION=1

# ---- cookies -------------------------------------------------------------
COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.tm

# ---- auth policy ---------------------------------------------------------
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
REMINDERS_ENABLED=true

# ---- first-run seed ------------------------------------------------------
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
